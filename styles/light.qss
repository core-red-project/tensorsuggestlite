/* Core Red Clean Light Theme */
QWidget {
    background: #f8fafc;
    color: #1e293b;
}

/* App Bar */
QWidget#appBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #b91c1c, stop:1 #dc2626);
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    padding: 8px 16px;
}

QLabel#appTitle {
    background: transparent;
    color: #ffffff;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.5px;
    padding-left: 6px;
}

/* Panels */
QWidget#leftPanel {
    background: #ffffff;
    border-right: 1px solid #e2e8f0;
    padding: 12px;
}

QWidget#rightPanel {
    background: #ffffff;
    padding: 12px;
}

/* Theme Toggle */
QToolButton#themeToggle {
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #ffffff;
}
QToolButton#themeToggle:hover {
    background: rgba(255, 255, 255, 0.35);
}

/* Buttons */
QPushButton#neumoButton {
    border-radius: 8px;
    padding: 8px 14px;
    border: 1px solid #cbd5e1;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffffff, stop:1 #f1f5f9);
    color: #0f172a;
    font-weight: 600;
}
QPushButton#neumoButton:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #991b1b;
}
QPushButton#neumoButton:pressed {
    background: #fecaca;
}
QPushButton#neumoButton:disabled {
    background: #f8fafc;
    color: #94a3b8;
    border: 1px solid #e2e8f0;
}

/* Inputs and Console */
QLineEdit#pathField {
    border-radius: 8px;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    padding: 6px 10px;
    color: #334155;
}

QTextEdit#consoleBox {
    border-radius: 8px;
    background: #0f172a;
    border: 1px solid #cbd5e1;
    padding: 10px;
    color: #38bdf8;
    font-size: 11px;
}

/* Status and Progress */
QLabel#statusLabel {
    background: #fef2f2;
    border-radius: 6px;
    padding: 2px 8px;
    color: #b91c1c;
    font-weight: 600;
    border: 1px solid #fecaca;
}

QProgressBar#progressBar {
    border-radius: 6px;
    background: #e2e8f0;
    text-align: center;
    color: #0f172a;
    font-weight: 600;
    font-size: 10px;
    border: 1px solid #cbd5e1;
}
QProgressBar#progressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #dc2626, stop:1 #ef4444);
}

QLabel#copyrightLabel {
    color: #94a3b8;
    font-size: 10px;
}
