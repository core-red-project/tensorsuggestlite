/* Core Red Dark Obsidian Theme */
QWidget {
    background: #0d0f14;
    color: #e5e7eb;
}

/* App Bar */
QWidget#appBar {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a0505, stop:0.5 #280a0a, stop:1 #111318);
    border-bottom: 1px solid rgba(220, 38, 38, 0.25);
    padding: 8px 16px;
}

QLabel#appTitle {
    background: transparent;
    color: #ffffff;
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.5px;
    padding-left: 6px;
}

/* Panels */
QWidget#leftPanel {
    background: #111318;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    padding: 12px;
}

QWidget#rightPanel {
    background: #111318;
    padding: 12px;
}

/* Theme Toggle */
QToolButton#themeToggle {
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #f3f4f6;
}
QToolButton#themeToggle:hover {
    background: rgba(220, 38, 38, 0.2);
    border-color: rgba(220, 38, 38, 0.4);
}

/* Buttons */
QPushButton#neumoButton {
    border-radius: 8px;
    padding: 8px 14px;
    border: 1px solid rgba(220, 38, 38, 0.35);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #991b1b, stop:1 #7f1d1d);
    color: #ffffff;
    font-weight: 600;
}
QPushButton#neumoButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #b91c1c, stop:1 #991b1b);
    border-color: #ef4444;
}
QPushButton#neumoButton:pressed {
    background: #581414;
}
QPushButton#neumoButton:disabled {
    background: #1c1e24;
    color: #4b5563;
    border: 1px solid rgba(255, 255, 255, 0.04);
}

/* Inputs and Console */
QLineEdit#pathField {
    border-radius: 8px;
    background: #181b22;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 6px 10px;
    color: #9ca3af;
}

QTextEdit#consoleBox {
    border-radius: 8px;
    background: #090a0d;
    border: 1px solid rgba(255, 255, 255, 0.07);
    padding: 10px;
    color: #38bdf8;
    font-size: 11px;
}

/* Status and Progress */
QLabel#statusLabel {
    background: rgba(255, 255, 255, 0.04);
    border-radius: 6px;
    padding: 2px 8px;
    color: #f87171;
    font-weight: 600;
    border: 1px solid rgba(248, 113, 113, 0.2);
}

QProgressBar#progressBar {
    border-radius: 6px;
    background: #181b22;
    text-align: center;
    color: #ffffff;
    font-weight: 600;
    font-size: 10px;
    border: 1px solid rgba(255, 255, 255, 0.05);
}
QProgressBar#progressBar::chunk {
    border-radius: 5px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #b91c1c, stop:1 #ef4444);
}

QLabel#copyrightLabel {
    color: #4b5563;
    font-size: 10px;
}
