/* Dark red palette - deep, high-contrast */
QWidget {
    background: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:1, stop:0 #0b0a0b, stop:1 #151212);
    color: #f7eaea;
}

/* App bar */
QWidget#appBar {
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #7f1d1d, stop:1 #5a1313);
    color: #fff7f7;
    padding: 10px 14px;
}
QLabel#appTitle {
    background: transparent;
    color: #fff7f7;
    font-weight: 700;
    font-size: 18px;
    padding-left: 6px;
}

/* Theme toggle (icon-only, circular) */
QToolButton#themeToggle {
    border-radius: 16px;
    min-width: 36px;
    min-height: 36px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.03);
}
QToolButton#themeToggle:hover { background: rgba(255,255,255,0.06); }

/* Neumorphic-like buttons */
QPushButton#neumoButton {
    border-radius: 12px;
    padding: 8px 14px;
    border: none;
    /* brighter, contrasty enabled appearance */
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #5a1515, stop:1 #7a1b1b);
    color: #fff5f5;
}
QPushButton#neumoButton:pressed { background: #9a1b1b; }

/* Disabled button state */
QPushButton#neumoButton:disabled {
    background: #241212; /* darker muted */
    color: #6b5252; /* muted text */
    border: 1px solid #1a0d0d;
    opacity: 0.5;
}

/* make disabled look consistent for export button (also neumoButton) */
QPushButton#neumoButton[enabled="false"] {
    background: #241212;
    color: #6b5252;
    opacity: 0.5;
}

/* Console box */
QTextEdit#consoleBox {
    border-radius: 12px;
    padding: 12px;
    border: none;
    background: qlineargradient(spread:pad, x1:0,y1:0,x2:0,y2:1, stop:0 #1b1212, stop:1 #1e1313);
    color: #f5e4e4;
    font-family: 'Consolas', 'Courier New', monospace;
}

/* Path field */
QLineEdit#pathField {
    border-radius: 12px;
    padding: 0px 12px;
    border: none;
    background: qlineargradient(spread:pad, x1:0,y1:0,x2:0,y2:1, stop:0 #1e1313, stop:1 #1b1212);
    color: #f5e4e4;
}

/* Progress bar */
QProgressBar#progressBar {
    border-radius: 9px;
    background: #1f1616;
    text-align: center;
    color: #e8d0d0;
}
QProgressBar#progressBar::chunk {
    border-radius: 9px;
    background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #8b2020, stop:1 #6a1515);
}

/* Status label */
QLabel#statusLabel { color: #e0c5c5; }

QLabel#copyrightLabel {
    color: #7a5555;
    padding-top: 4px;
}

