[flake8]
max-line-length = 100
exclude =
    .git,
    __pycache__,
    .venv,
    .venv_*,
    build,
    dist,
    *.egg-info,
    generated

# Error codes to ignore
ignore =
    # E203: whitespace before ':' (conflicts with Black)
    E203,
    # W503: line break before binary operator (conflicts with Black)
    W503,
    # E501: line too long (handled by black)
    E501

per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py: F401

# Complexity
max-complexity = 15

# Show source code for errors
show-source = True

# Count errors
count = True

# Statistics
statistics = True

